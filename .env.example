# ==============================================================================
# Sai Dwarak Portfolio Platform — Environment Configuration Template (Phase 2.2)
# ==============================================================================
# Architecture:
# - Database: Neon PostgreSQL via Drizzle ORM
# - Authentication: Clerk (Single Portfolio Administrator)
# - Media Storage: Cloudinary (Signed Direct Uploads)
#
# IMPORTANT:
# - Duplicate this file as .env.local for local development.
# - NEVER commit .env.local to Git.
# - NEVER prefix database, Clerk secrets, or Cloudinary secrets with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON POSTGRESQL (Server-only)
# ------------------------------------------------------------------------------
# Retrieve from Neon Console -> Connection Details -> Direct Connection or Pooled
# Format: postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. CLERK AUTHENTICATION (Phase 3 CMS Foundation)
# ------------------------------------------------------------------------------
# Retrieve from Clerk Dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Allowlist: Single portfolio administrator Clerk User ID (e.g. user_2abc123...)
# Only this User ID will have write access to portfolio content.
PORTFOLIO_ADMIN_USER_ID=user_your_admin_user_id_here

# ------------------------------------------------------------------------------
# 3. CLOUDINARY MEDIA STORAGE (Server-only configuration & signed uploads)
# ------------------------------------------------------------------------------
# Retrieve from Cloudinary Console -> Dashboard -> Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
