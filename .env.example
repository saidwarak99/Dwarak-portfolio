# ==============================================================================
# Sai Dwarak Portfolio Platform — Environment Configuration Template (Phase 2.3)
# ==============================================================================
# Architecture:
# - Backend: Supabase (PostgreSQL, Auth, Row Level Security, Storage)
# - Framework: Next.js App Router (Cookie-based Sessions)
#
# INSTRUCTIONS:
# 1. Duplicate this file as .env.local:
#    cp .env.example .env.local
# 2. Retrieve your credentials from Supabase Dashboard -> Project Settings -> API.
# 3. DO NOT commit .env.local to Git.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon API Key (Safe to expose on the browser client)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key-here

# Optional: Supabase Service Role Secret Key
# ONLY required for server-side administrator migration or setup scripts.
# Normal operations use user-scoped sessions and RLS. NEVER expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
